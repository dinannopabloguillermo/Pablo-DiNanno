# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (PostgreSQL en Docker: ver compose.yaml en la raíz)
DB_HOST=localhost
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_dev

# Session
SESSION_DRIVER=cookie

